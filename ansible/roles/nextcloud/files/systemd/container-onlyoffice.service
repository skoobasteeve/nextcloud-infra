# container-onlyoffice.service

[Unit]
Description=Podman container-onlyoffice.service
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers
BindsTo=pod-nextcloud-pod.service
After=pod-nextcloud-pod.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%h/.nextcloud_env
Restart=on-failure
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
	--cidfile=%t/%n.ctr-id \
	--cgroups=no-conmon \
	--rm \
	--pod-id-file %t/pod-nextcloud-pod.pod-id \
	--sdnotify=conmon \
	--replace \
	--detach \
	--env JWT_ENABLED=true \
	--env JWT_SECRET=${ONLYOFFICE_JWT_SECRET} \
	--volume %h/.podman/nextcloud/onlyoffice/logs:/var/log/onlyoffice:z \
	--volume %h/.podman/nextcloud/onlyoffice/data:/var/www/onlyoffice/Data:z \
	--volume %h/.podman/nextcloud/onlyoffice/lib:/var/lib/onlyoffice:z \
	--volume %h/.podman/nextcloud/onlyoffice/ds.conf.tmpl:/etc/onlyoffice/documentserver/nginx/ds.conf.tmpl:z \
	--label "io.containers.autoupdate=registry" \
	--log-driver=journald \
	--name onlyoffice docker.io/onlyoffice/documentserver:${ONLYOFFICE_VERSION}
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
